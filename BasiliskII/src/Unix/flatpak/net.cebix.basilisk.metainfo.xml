<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>net.cebix.basilisk</id>

  <name>Basilisk II</name>
  <summary>A 68k Macintosh emulator</summary>

  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-2.0-or-later</project_license>
  <content_rating type="oars-1.1" />

  <description><p>
Basilisk II is an Open Source 68k Macintosh emulator. That is, it enables you to run 68k Mac OS software on you computer. However, you still need a copy of Mac OS 7.x-8.1 and a Macintosh ROM image to use Basilisk II.
  </p></description>

  <url type="homepage">https://basilisk.cebix.net/</url>
  <url type="bugtracker">https://github.com/SegHaxx/macemu-flatpak/issues</url>
  <url type="vcs-browser">https://github.com/SegHaxx/macemu-flatpak</url>
  <developer id="com.haxxed">
    <name>Callum Lerwick</name>
  </developer>

  <launchable type="desktop-id">net.cebix.basilisk.desktop</launchable>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/flathub/net.cebix.basilisk/master/screenshots/1.png</image>
    </screenshot><screenshot>
      <image>https://raw.githubusercontent.com/flathub/net.cebix.basilisk/master/screenshots/2.png</image>
    </screenshot>
  </screenshots>

  <releases>
    <release version="2.8.6" date="2022-08-06">
      <description>
        <ul><li>Preferences are now stored inside the flatpak sandbox.</li>
        <li>Broken scrollbars in Mac OS 8.x on aarch64 has been fixed.</li>
				<li>JIT compiler is now enabled on x86_64.</li></ul>
      </description>
    </release>
    <release version="1.6.19" date="2021-06-19">
      <description>
        <p>Stability fixes. Happy Juneteenth!</p>
      </description>
    </release>
    <release version="1.0.0" date="2020-12-11">
      <description>
        <p>First Flathub release.</p>
      </description>
    </release>
  </releases>
</component>
